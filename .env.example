# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

# --- Anthropic (the agent's brain) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
MODEL_NAME=claude-sonnet-5

# --- Telegram (build this one first - fastest to set up) ---
# 1. Message @BotFather on Telegram -> /newbot -> get the token below.
# 2. Add the bot as admin to your channel.
# 3. Chat ID for a public channel is usually @your_channel_name.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X / Twitter (developer.x.com -> create a project/app, "Read and Write" access) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- WhatsApp Cloud API (developers.facebook.com -> WhatsApp product) ---
# This one takes the longest to get approved - start it early, add the
# credentials whenever it clears. The agent will just skip this channel
# and keep going until it's configured.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENT=

# --- Blog output ---
# Point this at the "posts" folder of your static site repo if you have one,
# so a `git push` from that repo publishes automatically.
BLOG_OUTPUT_DIR=./blog_posts

# --- Local state ---
DB_PATH=./agent_state.db
